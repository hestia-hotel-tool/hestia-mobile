# Secrets for Supabase Edge Functions.
#
# NOT the same thing as the project's .env.development / .env.production.
# Those are read by Expo (and inlined into the app bundle) and by the Node
# scripts. Edge Functions run on Supabase's servers and never see them.
#
# Setup:
#   1. cp supabase/functions/.env.example supabase/functions/.env
#   2. fill in the value
#   3. supabase secrets set --env-file supabase/functions/.env
#
# The real .env is gitignored by the root `.env` pattern. Prefer the
# --env-file form over `supabase secrets set KEY=value`, which leaves the key
# in your shell history.
#
# Changing a secret takes effect on the next invocation — no redeploy needed.
# Check what is set with `supabase secrets list` (values are shown as digests).

# Used by: supabase/functions/assistant
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Used by: supabase/functions/send-email  (guest emails — see docs/email.md)
# Pick ONE provider and fill in its keys; leave the others empty.
#   resend | sendgrid | postmark | mailgun | smtp
EMAIL_PROVIDER=resend
# Sender, on a domain verified with the provider.
EMAIL_FROM="Hestia Lost & Found <lostandfound@yourhotel.com>"
# Optional: where guests' replies go when the hotel has no contact_email.
EMAIL_REPLY_TO=
# resend / sendgrid / postmark (server token) / mailgun
EMAIL_API_KEY=
# mailgun only
MAILGUN_DOMAIN=
MAILGUN_REGION=
# smtp only — port 465 (Supabase blocks outbound 25 and 587)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
